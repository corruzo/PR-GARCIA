# ─── Supabase — Cliente (navegador) ──────────────────────────────────────────
# Prefijo VITE_ es OBLIGATORIO para que Vite exponga la variable al frontend.
VITE_SUPABASE_URL=https://TU_PROYECTO.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=sb_publishable_XXXXXXXXXXXXXXXXXXXXXXXXXX

# ─── Supabase — Servidor / API (Vercel Serverless) ───────────────────────────
# Estas variables NO van al navegador. Se usan solo en /api/*.
# La Service Role Key tiene permisos administrativos — NUNCA exponerla en el cliente.
SUPABASE_URL=https://TU_PROYECTO.supabase.co
SUPABASE_SERVICE_ROLE_KEY=eyJ...TU_SERVICE_ROLE_KEY

# ─── Puerto del servidor de desarrollo local (Vite lo usa como proxy de /api) ─
API_PORT=8787

# ─── Correo de contacto del pie de página (opcional; vacío = no se muestra) ────
VITE_CONTACT_EMAIL=
